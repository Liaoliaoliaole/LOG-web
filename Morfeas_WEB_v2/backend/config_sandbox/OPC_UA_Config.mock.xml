<?xml version="1.0" ?>
<!DOCTYPE NODESet SYSTEM 'Morfeas.dtd'>
<NODESet>
    <!-- SDAQ channels across can0 and can1 -->
    <CHANNEL>
        <ISO_CHANNEL>TE_CAN0_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>SDAQ</INTERFACE_TYPE>
        <ANCHOR>can0.1.CH1</ANCHOR>
        <DESCRIPTION>SDAQ address 1 on can0 measuring thermocouple 1</DESCRIPTION>
        <MIN>-50</MIN>
        <MAX>200</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>TE_CAN0_CH2</ISO_CHANNEL>
        <INTERFACE_TYPE>SDAQ</INTERFACE_TYPE>
        <ANCHOR>can0.1.CH2</ANCHOR>
        <DESCRIPTION>SDAQ address 1 on can0 measuring thermocouple 2</DESCRIPTION>
        <MIN>-50</MIN>
        <MAX>200</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>BRIDGE_CAN0_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>SDAQ</INTERFACE_TYPE>
        <ANCHOR>can0.2.CH1</ANCHOR>
        <DESCRIPTION>Bridge SDAQ on can0 address 2 channel 1</DESCRIPTION>
        <MIN>-100</MIN>
        <MAX>100</MAX>
        <UNIT>mV</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>THERM_CAN1_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>SDAQ</INTERFACE_TYPE>
        <ANCHOR>can1.3.CH1</ANCHOR>
        <DESCRIPTION>Thermistor SDAQ on can1 address 3</DESCRIPTION>
        <MIN>-20</MIN>
        <MAX>120</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>

    <!-- NOx sensor values mapped from can2 and can3 handlers -->
    <CHANNEL>
        <ISO_CHANNEL>NOX_CAN2</ISO_CHANNEL>
        <INTERFACE_TYPE>NOX</INTERFACE_TYPE>
        <ANCHOR>can2.sensor0.NOx</ANCHOR>
        <DESCRIPTION>Average NOx PPM from sensor on can2</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>1000</MAX>
        <UNIT>ppm</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>NOX_CAN2_O2</ISO_CHANNEL>
        <INTERFACE_TYPE>NOX</INTERFACE_TYPE>
        <ANCHOR>can2.sensor0.O2</ANCHOR>
        <DESCRIPTION>O2 percentage from NOx sensor on can2</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>25</MAX>
        <UNIT>%</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>NOX_CAN3</ISO_CHANNEL>
        <INTERFACE_TYPE>NOX</INTERFACE_TYPE>
        <ANCHOR>can3.sensor1.NOx</ANCHOR>
        <DESCRIPTION>Average NOx PPM from sensor on can3</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>1000</MAX>
        <UNIT>ppm</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>NOX_CAN3_O2</ISO_CHANNEL>
        <INTERFACE_TYPE>NOX</INTERFACE_TYPE>
        <ANCHOR>can3.sensor1.O2</ANCHOR>
        <DESCRIPTION>O2 percentage from NOx sensor on can3</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>25</MAX>
        <UNIT>%</UNIT>
    </CHANNEL>

    <!-- MTI telemetry feed -->
    <CHANNEL>
        <ISO_CHANNEL>MTI_TC4_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>MTI</INTERFACE_TYPE>
        <ANCHOR>167772180.TC4.CH1</ANCHOR>
        <DESCRIPTION>TC4 telemetry channel 1 temperature</DESCRIPTION>
        <MIN>-40</MIN>
        <MAX>250</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>MTI_TC4_CH2</ISO_CHANNEL>
        <INTERFACE_TYPE>MTI</INTERFACE_TYPE>
        <ANCHOR>167772180.TC4.CH2</ANCHOR>
        <DESCRIPTION>TC4 telemetry channel 2 temperature</DESCRIPTION>
        <MIN>-40</MIN>
        <MAX>250</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>MTI_TC4_CH3</ISO_CHANNEL>
        <INTERFACE_TYPE>MTI</INTERFACE_TYPE>
        <ANCHOR>167772180.TC4.CH3</ANCHOR>
        <DESCRIPTION>TC4 telemetry channel 3 temperature or no sensor</DESCRIPTION>
        <MIN>-40</MIN>
        <MAX>250</MAX>
        <UNIT>°C</UNIT>
    </CHANNEL>

    <!-- IOBOX RX inputs mapped to OPC UA -->
    <CHANNEL>
        <ISO_CHANNEL>IOBOX_RX1_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>IOBOX</INTERFACE_TYPE>
        <ANCHOR>184549374.RX1.CH1</ANCHOR>
        <DESCRIPTION>IOBOX RX1 first channel voltage</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>60</MAX>
        <UNIT>V</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>IOBOX_RX2_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>IOBOX</INTERFACE_TYPE>
        <ANCHOR>184549374.RX2.CH1</ANCHOR>
        <DESCRIPTION>IOBOX RX2 first channel status</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>60</MAX>
        <UNIT>V</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>IOBOX_RX3_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>IOBOX</INTERFACE_TYPE>
        <ANCHOR>184549374.RX3.CH1</ANCHOR>
        <DESCRIPTION>IOBOX RX3 first channel voltage</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>60</MAX>
        <UNIT>V</UNIT>
    </CHANNEL>
    <CHANNEL>
        <ISO_CHANNEL>IOBOX_RX4_CH1</ISO_CHANNEL>
        <INTERFACE_TYPE>IOBOX</INTERFACE_TYPE>
        <ANCHOR>184549374.RX4.CH1</ANCHOR>
        <DESCRIPTION>IOBOX RX4 first channel voltage (low or zero)</DESCRIPTION>
        <MIN>0</MIN>
        <MAX>60</MAX>
        <UNIT>V</UNIT>
    </CHANNEL>
</NODESet>