Cmnd_Alias ALLOW_UPDATE_MORFEAS_WEB = /bin/systemctl restart apache2, \
                                      /bin/rm, \
                                      /var/www/html/morfeas_web/update.sh

www-data ALL = (ALL) NOPASSWD: ALLOW_UPDATE_MORFEAS_WEB

